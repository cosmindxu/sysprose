{
  "name": "sysprose",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sysprose: a pure-browser system modeler with an AI-agent focus, models developed as textual definitions and exercised by agents in the browser",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "serve": "tsx src/server/index.ts",
    "collab": "tsx scripts/collab-server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src/ test/ scripts/",
    "test": "vitest run --reporter=default",
    "test:watch": "vitest",
    "test:report": "vitest run --reporter=json --outputFile=test-results/unit-results.json",
    "test:e2e": "playwright test",
    "report": "tsx scripts/gen-test-report.ts",
    "interop": "tsx scripts/pilot-roundtrip.ts",
    "check": "tsx scripts/sysml-check.ts",
    "campaign": "vitest run test/campaign",
    "codes": "tsx scripts/gen-diagnostic-codes.ts",
    "bench": "tsx scripts/agent-repair-bench.ts",
    "shot:hero": "node scripts/shot-hero.mjs"
  },
  "dependencies": {
    "@types/express": "^5.0.6",
    "@xyflow/react": "^12.3.5",
    "ajv": "^8.20.0",
    "elkjs": "^0.9.3",
    "express": "^5.2.1",
    "langium": "^3.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.185.1",
    "ws": "^8.21.0",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.31",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.185.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^4.3.4",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^25.0.1",
    "langium-cli": "^3.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
